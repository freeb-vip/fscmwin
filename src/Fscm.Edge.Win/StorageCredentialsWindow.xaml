<Window
  x:Class="Fscm.Edge.Win.StorageCredentialsWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="NAS 访问凭据"
  Width="560"
  Height="360"
  ResizeMode="NoResize"
  WindowStartupLocation="CenterOwner"
  Background="#F8FAFC">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock FontSize="20" FontWeight="SemiBold" Text="NAS 访问凭据" />
    <TextBlock Grid.Row="1" Margin="0,8,0,18" Foreground="#64748B" Text="密码关闭后不再显示。" />
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Foreground="#64748B" Text="NAS 地址" />
      <TextBox x:Name="AddressTextBox" Grid.Column="1" MinHeight="52" AcceptsReturn="True" IsReadOnly="True" TextWrapping="Wrap" />
      <Button Grid.Column="2" Margin="8,0,0,0" Click="OnCopyAddressClick" Content="复制" />
    </Grid>
    <Grid Grid.Row="3" Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Foreground="#64748B" Text="账号" />
      <TextBox x:Name="UsernameTextBox" Grid.Column="1" IsReadOnly="True" />
      <Button Grid.Column="2" Margin="8,0,0,0" Click="OnCopyUsernameClick" Content="复制" />
    </Grid>
    <Grid Grid.Row="4" Margin="0,12,0,0" VerticalAlignment="Top">
      <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Foreground="#64748B" Text="密码" />
      <TextBox x:Name="PasswordTextBox" Grid.Column="1" IsReadOnly="True" FontFamily="Consolas" />
      <Button Grid.Column="2" Margin="8,0,0,0" Click="OnCopyPasswordClick" Content="复制" />
    </Grid>
    <Button Grid.Row="5" HorizontalAlignment="Right" MinWidth="90" IsDefault="True" Click="OnCloseClick" Content="完成" />
  </Grid>
</Window>
